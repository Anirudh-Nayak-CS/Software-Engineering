# Create backend/.env and set a newly generated Gemini key here.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
REQUIREMENT_SPEC_TOKENS=8192
SDLC_TOKENS=4096
GEMINI_API_TIMEOUT=180
GEMINI_API_RETRIES=2
GEMINI_API_RETRY_DELAY=2.0
DOCUMENT_DIRECTORY=./data/healthcare_documents
